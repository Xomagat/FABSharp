# IO functions v0.1

# Whole files
file_exists   fab_file_exists   bool         : string
file_size     fab_file_size     long         : string
file_read     fab_file_read     string       : string
file_write    fab_file_write    bool         : string, string
file_append   fab_file_append   bool         : string, string
file_lines    fab_file_lines    list<string> : string
file_delete   fab_file_delete   bool         : string
file_rename   fab_file_rename   bool         : string, string

# Handles (mode: "r", "w", "a", "rb", "wb")
file_open     fab_file_open     long         : string, string
file_close    fab_file_close    bool         : long
file_eof      fab_file_eof      bool         : long
file_get_line fab_file_get_line string       : long
file_put      fab_file_put      bool         : long, string
file_putln    fab_file_putln    bool         : long, string

io_error      fab_io_error      string       :