# Integers functions
# Create on 08.10.2026
# Last update 11.10.2026

# Const
const INT_MIN int -2147483648
const INT_MAX int 2147483647
const CHAR_MIN int -128
const CHAR_MAX int 127
const SHORT_MIN short -32768
const SHORT_MAX short 32767
const LONG_MIN long -9223372036854775808
const LONG_MAX long 9223372036854775807
const FLOAT_MIN float 1.17549435e-38
const FLOAT_MAX float 3.40282347e+38
const FLOAT_EPSILON float 1.19209290e-07
const DOUBLE_MIN double 2.2250738585072014e-308
const DOUBLE_MAX double 1.7976931348623157e+308
const DOUBLE_EPSILON double 2.2204460492503131e-16

# Short
short.to_str      fab_to_str_short      string : short
short.is_positive fab_is_positive_short bool   : short
short.is_negative fab_is_negative_short bool   : short
short.is_zero     fab_is_zero_short     bool   : short
short.is_even     fab_is_even_short     bool   : short
short.is_odd      fab_is_odd_short      bool   : short
short.abs         fab_abs_short         short  : short
short.sign        fab_sign_short        int    : short
short.to_bool     fab_to_bool_short     bool   : short
short.to_char     fab_to_char_short     char   : short
short.to_int      fab_to_int_short      int    : short
short.to_long     fab_to_long_short     long   : short
short.to_float    fab_to_float_short    float  : short
short.to_double   fab_to_double_short   double : short

