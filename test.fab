use system;

define main()
{
    int x = 5;
    writeln size_of(int);        // 4
    writeln size_of(x);          // 4
    writeln size_of(double);     // 8
    writeln type(x);             // int
    writeln type([1, 2]);        // (нужен expected-тип, см. ниже)

    asm("nop");
    asm("movl $0, %eax", "r", x);        // inputs: "r" на каждый аргумент
    asm("xor %eax, %eax\n\tnop", "~{eax}");  // только clobber
    system("echo hi");
}