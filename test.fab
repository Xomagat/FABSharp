struct Point { int x; int y; }

class Animal
{
public:
    string name;
    Animal(string n) { name = n; }
    define hello() -> string { return "I am " + name; }
}

define main() -> int
{
    // значения-классы
    dict<string, Animal> zoo = {"a": new Animal("Rex")};
    zoo["b"] = new Animal("Tom");
    writeln zoo["a"].hello();               // I am Rex
    writeln zoo.contains("zzz");            // false

    // значения-структуры
    dict<string, Point> pts = {"o": Point(0, 0)};
    pts["a"] = Point(1, 2);
    pts["a"].x = 10;                        // меняется на месте
    Point p = pts["a"];
    writeln p.x;                            // 10
    writeln pts.length();                   // 2
    for (string k in pts) writeln $"{k}: {pts[k].x},{pts[k].y}";
    Point gone = pts.pop("o");
    writeln pts.contains("o");              // false

    // вложенные контейнеры
    dict<string, list<int>> groups = {};
    groups["even"] = [2, 4];
    groups["even"].addend(6);
    writeln groups["even"].length();        // 3
}