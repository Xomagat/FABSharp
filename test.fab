define f(long x) -> long { return x * 2; }
define g(long a, long b = 10) -> long { return a + b; }

class A { public: define h(long x) -> long { return x + 1; } }

define main() -> int
{
    writeln f(100);       // 200
    writeln g(5);         // 15
    A a = new A();
    writeln a.h(41);      // 42
    return 0;
}