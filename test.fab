define main() -> int
{
    dict<string, int> ages;
    dict<string, int> extra = {"Jonn": 15, "Jo": 24};

    // ADD, CHANGE
    ages.set("Alice", 25);              // добавляет или обновляет ключ "Alice" значением 25
    ages.set("Bob", 30);                // добавляет или обновляет ключ "Bob" значением 30
    ages.merge(extra);                  // объединяет текущий словарь со словарем extra

    // SIZE
    writeln ages.length();              // 3
    writeln ages.empty();               // false
    writeln ages.capacity();            // текущая емкость буфера памяти словаря (int)

    // ACCESS
    writeln ages.get("Alice");          // 25
    writeln ages.get_or("Charlie", 18); // 18 (возвращает 18, так как ключа "Charlie" нет)
    writeln ages.key_at(0);             // "Alice" (получает ключ по внутреннему индексу)
    writeln ages.value_at(0);           // 25 (получает значение по внутреннему индексу)

    // SEARCH
    writeln ages.contains("Bob");       // true
    writeln ages.contains_value(30);    // true

    // REMOVE
    writeln ages.remove("Bob");         // true (удаляет ключ "Bob" и возвращает статус)
    writeln ages.pop("Alice");          // 25 (удаляет ключ "Alice" и возвращает его значение)
    ages.clear();                       // очищает словарь, оставляя его пустым

    // KEYS, VALUES, COPY
    ages.set("Ivan", 20);
    ages.set("Petr", 35);

    list<string> all_keys = ages.keys(); // ["Ivan", "Petr"]
    list<int> all_values = ages.values(); // [20, 35]
    dict<string, int> backup = ages.copy(); // создает независимую копию словаря
}