define main() -> int
{
    string s = "This is string on FAB#";

    writeln s.length();                 // 22
    writeln s.empty();                  // false

    writeln s.find("string");           // 8
    writeln s.substr(5, 2);             // "is"
    writeln s.compare("ABC") == 0;      // 0
    writeln s.first();                  // 'T'
    writeln s.last();                   // '#'
    writeln s.to_upper();               // "THIS IS STRING ON FAB#"
    writeln s.to_lower();               // "this is string on fab#"
    writeln s.replace("FAB#", "C++");   // "This is string on C++"
    writeln s.contains("FAB");          // true
    writeln s.start_with("This");       // true
    writeln s.ends_with("#");           // true

    string num = "123";
    writeln num.to_int();               // 123
    writeln num.to_long();              // 123
    writeln num.to_double();            // 123.0

    s = "This is string on FAB#";
    writeln s.find('i');                // 2
    writeln s.rfind("is");              // 5
    writeln s.at(5);                    // 'i'
    writeln s.count("is");              // 2
    writeln s.trim();                   // "This is string on FAB#"
    writeln s.repeat(2);                // "This is string on FAB#This is string on FAB#"
    writeln s.reverse();                // "#BAF no gnirts si sihT"
    writeln s.capitalize();             // "This is string on fab#"
    writeln s.pad_left(25, '.');        // "...This is string on FAB#"
    writeln s.pad_right(25, '.') + "\tSorry, this isn't working correctly yet.";
    writeln s.equals_ignore_case("this is string on fab#"); // true
    writeln s.is_blank();               // false
    writeln s.is_numeric();             // false

    string b = "true";
    writeln b.to_bool();                // true

    writeln s.split(" ");               // [This, is, string, on, FAB#]
}