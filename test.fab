define main() -> int
{
    list<int> a = [1, 2, 3, 4, 5];

    a.add(0);               // [0, 1, 2, 3, 4, 5]
    a.addend(6);            // [0, 1, 2, 3, 4, 5, 6]

    writeln a;              // [0, 1, 2, 3, 4, 5, 6]
    writeln a.length();     // 7
    a[2] = 99;
    writeln a[2];           // 99
    writeln "Hello"[2];     // 'l'
}