use thread;
use system;

define worker(int id, string name)
{
    writeln $"worker {id}: {name}";
}

define main() -> int
{
    auto ss = ticks_ms();
    //thread t = spawn(worker, 1, "a");   // первый аргумент: имя функции
    //t.join();
    worker(1, "a");
    writeln ticks_ms() - ss;
    return 0;
}