define main() -> int
{
    list<int> a = [1, 2, 3, 4, 5];

    a.add(0);               // [0, 1, 2, 3, 4, 5]
    a.addend(6);            // [0, 1, 2, 3, 4, 5, 6]

    writeln a;              // [0, 1, 2, 3, 4, 5, 6]
    writeln a.length();     // 7
    writeln a.capacity();   // 8
    writeln a.empty();      // 0
}