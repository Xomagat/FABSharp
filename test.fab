define main() -> int
{
    int x = 0;
    for (;;) { writeln "for (;;)"; if (x) break; x++; }          // бесконечный цикл
    writeln '-'.repeat(10);
    for (int i = 0; i < 10;) { writeln i; i++; }                 // init + условие
    writeln '-'.repeat(10);
    int i = 0;
    for (; i < 10;) { writeln i + 10; i++; }                     // только условие, как while
    writeln '-'.repeat(10);
    for (int j = 0;; j++) { writeln "Hello World"; break; }      // без условия
}