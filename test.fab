use date;

define main() -> int
{
    writeln year_now;                 // 2026
    writeln hour_now;                 // your hour now

    date d = date_now();
    writeln d.to_str();               // 2026-10-28 (or your date)
    writeln d.weekday_name();         // wednesday (or your weekday)
    d.add_days(30);
    writeln d.format("%d.%m.%Y");     // 27.11.2026

    date a = date_new(2026, 1, 31);
    a.add_months(1);
    writeln a.to_str();               // 2026-02-28

    writeln d.diff_days(a);

    time t = time_new(23, 30, 0);
    t.add_minutes(90);
    writeln t.to_str();               // 01:00:00

    delete d; delete a; delete t;
    return 0;
}