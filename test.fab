use convert;

define main() -> int
{
    hex h = hex("ff");
    writeln h.to_str();                       // ff
    writeln h.to_int();                       // 255
    writeln h.format(width=4, prefix=true);   // 0x00ff

    bin b = h.to_bin();
    writeln b.to_str();                       // 11111111
    oct o = oct(8);
    writeln o.to_str();                       // 10

    b.from_hex("a");                          // still a bin, now 10
    writeln b.to_str();                       // 1010
    b.from_int(5);
    writeln $"{b}";                           // 101

    writeln convert.to_int(h);                // 255
    writeln convert.to_int("77", 8);          // 63
    writeln convert.to_int("zz", fallback=-1);// -1
    writeln convert.to_str(255, 2);           // 11111111
    hex x = convert.to_hex("1010", 2);        // 0xa
    writeln convert.to_oct(x).to_str();       // 12

    hex bad = hex("zz");                      // null, but safe to use
    writeln bad.to_str();                     // 0
    writeln convert.is_hex("zz");             // false
    return 0;
}