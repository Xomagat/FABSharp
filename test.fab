define main() -> int
{
    // SHORT
    short s = -5;

    writeln s.to_str();       // "-5"
    writeln s.is_positive();  // false
    writeln s.is_negative();  // true
    writeln s.is_zero();      // false
    writeln s.is_even();      // false
    writeln s.is_odd();       // true
    writeln s.abs();          // 5
    writeln s.sign();         // -1
    writeln s.to_bool();      // true
    writeln s.to_char();      // символ с кодом -5
    writeln s.to_int();       // -5
    writeln s.to_long();      // -5
    writeln s.to_float();     // -5.0
    writeln s.to_double();    // -5.0

    // INT
    int i = 42;

    writeln i.to_str();       // "42"
    writeln i.is_positive();  // true
    writeln i.is_negative();  // false
    writeln i.is_zero();      // false
    writeln i.is_even();      // true
    writeln i.is_odd();       // false
    writeln i.abs();          // 42
    writeln i.sign();         // 1
    writeln i.to_bool();      // true
    writeln i.to_char();      // '*' (символ с ASCII кодом 42)
    writeln i.to_short();     // 42
    writeln i.to_long();      // 42
    writeln i.to_float();     // 42.0
    writeln i.to_double();    // 42.0

    // LONG
    long l = 0;

    writeln l.to_str();       // "0"
    writeln l.is_positive();  // false
    writeln l.is_negative();  // false
    writeln l.is_zero();      // true
    writeln l.is_even();      // true
    writeln l.is_odd();       // false
    writeln l.abs();          // 0
    writeln l.sign();         // 0
    writeln l.to_bool();      // false
    writeln l.to_char();      // '\0' (символ с кодом 0)
    writeln l.to_short();     // 0
    writeln l.to_int();       // 0
    writeln l.to_float();     // 0.0
    writeln l.to_double();    // 0.0

    // FLOAT
    float f = -3.7;

    writeln f.to_str();       // "-3.7"
    writeln f.is_positive();  // false
    writeln f.is_negative();  // true
    writeln f.is_zero();      // false
    writeln f.is_nan();       // false
    writeln f.is_inf();       // false
    writeln f.is_finite();    // true
    writeln f.abs();          // 3.7
    writeln f.sign();         // -1
    writeln f.floor();        // -4.0
    writeln f.ceil();         // -3.0
    writeln f.trunc();        // -3.0
    writeln f.round();        // -4.0
    writeln f.to_bool();      // true
    writeln f.to_char();      // символ с кодом -3
    writeln f.to_short();     // -3
    writeln f.to_int();       // -3
    writeln f.to_long();      // -3
    writeln f.to_double();    // -3.7

    // DOUBLE
    double d = 15.55;

    writeln d.to_str();       // "15.55"
    writeln d.is_positive();  // true
    writeln d.is_negative();  // false
    writeln d.is_zero();      // false
    writeln d.is_nan();       // false
    writeln d.is_inf();       // false
    writeln d.is_finite();    // true
    writeln d.abs();          // 15.55
    writeln d.sign();         // 1
    writeln d.floor();        // 15.0
    writeln d.ceil();         // 16.0
    writeln d.trunc();        // 15.0
    writeln d.round();        // 16.0
    writeln d.to_bool();      // true
    writeln d.to_char();      // символ с кодом 15
    writeln d.to_short();     // 15
    writeln d.to_int();       // 15
    writeln d.to_long();      // 15
    writeln d.to_float();     // 15.55
}