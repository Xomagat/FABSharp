define main() -> int
{
    bool t = true;
    bool f = false;

    // CONVERT
    writeln t.to_str();                 // true
    writeln f.to_str();                 // false
    writeln t.to_bin();                 // 1
    writeln f.to_bin();                 // 0
    writeln t.to_int();                 // 1
    writeln f.to_int();                 // 0
    writeln t.to_short();               // 1
    writeln t.to_long();                // 1
    writeln t.to_float();               // 1
    writeln t.to_double();              // 1

    // LOGIC
    writeln t.negate();                 // false
    writeln f.negate();                 // true
    writeln t.xor(f);                   // true
    writeln t.xor(t);                   // false
    writeln t.and(t);                   // true
    writeln t.and(f);                   // false
    writeln f.or(f);                    // false
    writeln t.or(f);                    // true
    writeln t.nand(t);                  // false
    writeln t.nand(f);                  // true
    writeln f.nor(f);                   // true
    writeln t.nor(f);                   // false
    writeln t.xnor(t);                  // true
    writeln t.xnor(f);                  // false
    writeln t.implies(f);               // false
    writeln f.implies(t);               // true
    writeln f.implies(f);               // true

    // COMPARE
    writeln t.compare(f);               // 1
    writeln f.compare(t);               // -1
    writeln t.compare(t);               // 0

    // LITERALS, EXPRESSIONS, CHAINS
    writeln true.to_str();              // true
    writeln (5 > 3).to_str();           // true
    writeln (5 < 3).to_str();           // false
    writeln t.and(t).negate().to_str(); // false
    writeln (1 == 1).xor(2 == 3);       // true

    // IN CONDITIONS
    if (t.xor(f))
        writeln "xor ok";               // xor ok
    if (f.implies(t) && t.xnor(t))
        writeln "implies ok";           // implies ok
}