// strbuf_test.fab
// Запуск: fab -r strbuf_test.fab
// Код возврата программы = число проваленных проверок.

use io;
use system;
use strbuf;

int g_pass = 0;
int g_fail = 0;

// ---------- мини-фреймворк ----------
define section(string title)
{
    writeln;
    writeln $"== {title} ==";
}

define check(string name, bool cond)
{
    if (cond) { g_pass++; }
    else { g_fail++; writeln $"  FAIL  {name}"; }
}

define check_eq(string name, string got, string expected)
{
    if (got == expected) { g_pass++; }
    else { g_fail++; writeln $"  FAIL  {name}: got [{got}], expected [{expected}]"; }
}

define check_eq(string name, int got, int expected)
{
    if (got == expected) { g_pass++; }
    else { g_fail++; writeln $"  FAIL  {name}: got [{got}], expected [{expected}]"; }
}

define check_eq(string name, char got, char expected)
{
    if (got == expected) { g_pass++; }
    else { g_fail++; writeln $"  FAIL  {name}: got [{got}], expected [{expected}]"; }
}

// ---------- 1. базовое API ----------
define test_basic()
{
    section("basic: new / addend / addend_char / length / clear / to_str");
    strbuf sb = sb_new();

    check_eq("new: length", sb.length(), 0);
    check_eq("new: to_str", sb.to_str(), "");
    check("new: is_empty", sb.is_empty());

    sb.addend("Hello");
    sb.addend(", ");
    sb.addend("world");
    sb.addend('!');
    check_eq("addend: to_str", sb.to_str(), "Hello, world!");
    check_eq("addend: length", sb.length(), 13);
    check("addend: not empty", !sb.is_empty());

    sb.addend("");
    check_eq("addend empty string", sb.length(), 13);

    string snap = sb.to_str();
    sb.addend("?");
    check_eq("to_str is a copy", snap, "Hello, world!");
    check_eq("buffer keeps growing", sb.to_str(), "Hello, world!?");

    string s = $"<{sb}>";
    check_eq("f-string with strbuf", s, "<Hello, world!?>");

    sb.clear();
    check_eq("clear: length", sb.length(), 0);
    check_eq("clear: to_str", sb.to_str(), "");
    check("clear: is_empty", sb.is_empty());

    sb.addend("again");
    check_eq("reuse after clear", sb.to_str(), "again");

    string kept = sb.to_str();
    delete sb;
    check_eq("to_str survives delete", kept, "again");
}

// ---------- 2. числа, bool, char без промежуточных строк ----------
define test_addend_numbers()
{
    section("addend: numbers, bool, char");
    strbuf sb = sb_new();

    short sh = 123;
    int neg = -45;
    int zero = 0;
    long big = LONG_MAX;
    long small = LONG_MIN;
    float f = 1.5;
    double d = 2.5;
    double nd = -0.5;
    double z = 0.0;
    bool t = true;
    bool fl = false;

    sb.addend(sh);    check_eq("addend short",       sb.to_str(), "123");   sb.clear();
    sb.addend(neg);   check_eq("addend negative",    sb.to_str(), "-45");   sb.clear();
    sb.addend(zero);  check_eq("addend zero",        sb.to_str(), "0");     sb.clear();
    sb.addend(INT_MAX); check_eq("addend INT_MAX",   sb.to_str(), "2147483647");  sb.clear();
    sb.addend(INT_MIN); check_eq("addend INT_MIN",   sb.to_str(), "-2147483648"); sb.clear();
    sb.addend(big);   check_eq("addend LONG_MAX",    sb.to_str(), "9223372036854775807");  sb.clear();
    sb.addend(small); check_eq("addend LONG_MIN",    sb.to_str(), "-9223372036854775808"); sb.clear();
    sb.addend(f);     check_eq("addend float",       sb.to_str(), "1.5");   sb.clear();
    sb.addend(d);     check_eq("addend double",      sb.to_str(), "2.5");   sb.clear();
    sb.addend(nd);    check_eq("addend neg double",  sb.to_str(), "-0.5");  sb.clear();
    sb.addend(z);     check_eq("addend 0.0",         sb.to_str(), "0");     sb.clear();
    sb.addend(t);     check_eq("addend true",        sb.to_str(), "true");  sb.clear();
    sb.addend(fl);    check_eq("addend false",       sb.to_str(), "false"); sb.clear();
    sb.addend('x');   check_eq("addend char",        sb.to_str(), "x");     sb.clear();

    sb.addend(1);
    sb.addend(",");
    sb.addend(2.5);
    sb.addend(",");
    sb.addend(true);
    sb.addend(",");
    sb.addend('z');
    check_eq("mixed chain", sb.to_str(), "1,2.5,true,z");

    delete sb;
}

// ---------- 3. repeat / join / line ----------
define test_repeat_join()
{
    section("addend_line / addend_repeat / addend_char_repeat / addend_join");
    strbuf sb = sb_new();

    sb.addend_line("line");
    check_eq("addend_line", sb.to_str(), "line\n");
    sb.clear();

    sb.addend_repeat("ab", 3);
    check_eq("addend_repeat", sb.to_str(), "ababab");
    sb.addend_repeat("x", 0);
    sb.addend_repeat("x", -2);
    sb.addend_repeat("", 5);
    check_eq("addend_repeat: no-ops", sb.to_str(), "ababab");
    sb.clear();

    sb.addend_char_repeat('-', 5);
    check_eq("addend_char_repeat", sb.to_str(), "-----");
    sb.addend_char_repeat('x', 0);
    check_eq("addend_char_repeat 0", sb.length(), 5);
    sb.clear();

    list<string> parts = ["a", "b", "c"];
    sb.addend_join(parts, ", ");
    check_eq("join", sb.to_str(), "a, b, c");
    sb.clear();

    sb.addend_join(parts, "");
    check_eq("join: empty separator", sb.to_str(), "abc");
    sb.clear();

    list<string> solo = ["solo"];
    sb.addend_join(solo, ", ");
    check_eq("join: one element", sb.to_str(), "solo");
    sb.clear();

    list<string> none = [];
    sb.addend_join(none, ", ");
    check_eq("join: empty list", sb.to_str(), "");

    delete sb;
}

// ---------- 4. правка на месте ----------
define test_edit()
{
    section("edit: insert / remove / truncate / reverse / set_at / replace");
    strbuf sb = sb_new();

    // insert
    sb.addend("held");
    sb.insert(2, "llo wor");
    check_eq("insert middle", sb.to_str(), "hello world");
    sb.insert(0, ">> ");
    check_eq("insert at start", sb.to_str(), ">> hello world");
    sb.insert(sb.length(), " <<");
    check_eq("insert at end", sb.to_str(), ">> hello world <<");
    sb.insert(100, "zzz");
    sb.insert(-1, "zzz");
    sb.insert(0, "");
    check_eq("insert: bad position ignored", sb.to_str(), ">> hello world <<");

    // remove
    sb.remove(0, 3);
    check_eq("remove at start", sb.to_str(), "hello world <<");
    sb.remove(11, 100);
    check_eq("remove: length clamped", sb.to_str(), "hello world");
    sb.remove(-1, 2);
    sb.remove(50, 1);
    sb.remove(5, 0);
    check_eq("remove: bad arguments ignored", sb.to_str(), "hello world");
    sb.remove(5, 6);
    check_eq("remove middle", sb.to_str(), "hello");

    // truncate
    sb.truncate(10);
    check_eq("truncate: bigger than length", sb.to_str(), "hello");
    sb.truncate(-1);
    check_eq("truncate: negative", sb.to_str(), "hello");
    sb.truncate(3);
    check_eq("truncate: 3", sb.to_str(), "hel");
    sb.truncate(0);
    check_eq("truncate: 0", sb.to_str(), "");
    check_eq("truncate: length", sb.length(), 0);
    sb.addend("x");
    check_eq("addend after truncate", sb.to_str(), "x");

    // reverse
    sb.clear();
    sb.addend("hello");
    sb.reverse();
    check_eq("reverse odd", sb.to_str(), "olleh");
    sb.clear();
    sb.addend("ab");
    sb.reverse();
    check_eq("reverse even", sb.to_str(), "ba");
    sb.clear();
    sb.reverse();
    check_eq("reverse empty", sb.to_str(), "");

    // set_at
    sb.clear();
    sb.addend("hello");
    sb.set_at(0, 'J');
    sb.set_at(4, 'y');
    check_eq("set_at", sb.to_str(), "Jelly");
    sb.set_at(5, 'x');
    sb.set_at(-1, 'x');
    check_eq("set_at: bad index ignored", sb.to_str(), "Jelly");
    check_eq("set_at: length", sb.length(), 5);

    // replace
    sb.clear();
    sb.addend("banana");
    check_eq("replace: count", sb.replace("a", "o"), 3);
    check_eq("replace: result", sb.to_str(), "bonono");
    check_eq("replace: two matches", sb.replace("no", "NO"), 2);
    check_eq("replace: result 2", sb.to_str(), "boNONO");
    check_eq("replace: no match", sb.replace("zzz", "y"), 0);
    check_eq("replace: empty pattern", sb.replace("", "x"), 0);
    check_eq("replace: unchanged", sb.to_str(), "boNONO");
    check_eq("replace: length", sb.length(), 6);

    sb.clear();
    sb.addend("aaaa");
    check_eq("replace: shrink count", sb.replace("aa", "b"), 2);
    check_eq("replace: shrink", sb.to_str(), "bb");

    sb.clear();
    sb.addend("ab");
    sb.replace("b", "xyz");
    check_eq("replace: grow", sb.to_str(), "axyz");
    check_eq("replace: grow length", sb.length(), 4);
    sb.replace("x", "");
    check_eq("replace: with empty", sb.to_str(), "ayz");

    sb.clear();
    sb.addend("aaa");
    sb.replace("aa", "b");
    check_eq("replace: no overlap", sb.to_str(), "ba");

    delete sb;
}

// ---------- 5. чтение и поиск ----------
define test_read()
{
    section("read: at / find / contains / starts_with / ends_with / substr");
    strbuf sb = sb_from("hello world");

    check("is_empty: false", !sb.is_empty());

    check_eq("at 0", sb.at(0), 'h');
    check_eq("at 4", sb.at(4), 'o');
    check_eq("at last", sb.at(10), 'd');
    check_eq("at: out of range", sb.at(11), '\0');
    check_eq("at: negative", sb.at(-1), '\0');

    check_eq("find world", sb.find("world"), 6);
    check_eq("find first o", sb.find("o"), 4);
    check_eq("find missing", sb.find("xyz"), -1);
    check_eq("find empty", sb.find(""), 0);

    check("contains: yes", sb.contains("lo wo"));
    check("contains: no", !sb.contains("xyz"));

    check("starts_with: yes", sb.starts_with("hello"));
    check("starts_with: no", !sb.starts_with("world"));
    check("starts_with: longer", !sb.starts_with("hello world!"));
    check("starts_with: empty", sb.starts_with(""));

    check("ends_with: yes", sb.ends_with("world"));
    check("ends_with: no", !sb.ends_with("hello"));
    check("ends_with: longer", !sb.ends_with("!hello world"));
    check("ends_with: empty", sb.ends_with(""));

    check_eq("substr start", sb.substr(0, 5), "hello");
    check_eq("substr middle", sb.substr(6, 5), "world");
    check_eq("substr: clamped", sb.substr(6, 100), "world");
    check_eq("substr: start == length", sb.substr(11, 1), "");
    check_eq("substr: negative start", sb.substr(-1, 3), "");
    check_eq("substr: zero length", sb.substr(2, 0), "");

    sb.clear();
    check("is_empty after clear", sb.is_empty());

    delete sb;
}

// ---------- 6. создание и копии ----------
define test_create_copy()
{
    section("create: sb_from / sb_with_capacity / copy");

    strbuf a = sb_from("abc");
    check_eq("sb_from", a.to_str(), "abc");

    strbuf b = a.copy();
    b.addend("def");
    check_eq("copy: original unchanged", a.to_str(), "abc");
    check_eq("copy: copy changed", b.to_str(), "abcdef");
    a.addend("X");
    check_eq("copy: independent", b.to_str(), "abcdef");

    strbuf c = sb_with_capacity(1000);
    check("with_capacity: capacity", c.capacity() >= 1000);
    check_eq("with_capacity: empty", c.length(), 0);
    c.addend("ok");
    check_eq("with_capacity: works", c.to_str(), "ok");

    string ns = null;
    strbuf d = sb_from(ns);
    check_eq("sb_from(null string)", d.length(), 0);
    d.addend(ns);
    check_eq("addend(null string) ignored", d.length(), 0);

    delete a;
    delete b;
    delete c;
    delete d;
}

// ---------- 7. null-безопасность ----------
define test_null_safety()
{
    section("null safety");
    strbuf n = null;

    n.addend("x");
    n.addend('y');
    n.addend(5);
    n.addend_line("z");
    n.insert(0, "a");
    n.remove(0, 1);
    n.truncate(0);
    n.reverse();
    n.clear();

    check_eq("null: length", n.length(), 0);
    check_eq("null: to_str", n.to_str(), "");
    check("null: is_empty", n.is_empty());
    check_eq("null: at", n.at(0), '\0');
    check_eq("null: find", n.find("x"), -1);
    check("null: contains", !n.contains("x"));
    check_eq("null: capacity", n.capacity(), 0);

    delete n;
}

// ---------- 8. вывод ----------
define test_output()
{
    section("output: print / println / write_to");

    strbuf v = sb_from("visible");
    write "  print:   "; v.print(); writeln;
    write "  println: "; v.println();
    delete v;

    strbuf sb = sb_new();
    sb.addend_line("alpha");
    sb.addend_line("beta");

    file f = file_open("strbuf_test.tmp", "wb");
    check("write_to: file opened", f.is_open());
    check("write_to: returns true", sb.write_to(f));
    f.close();
    check_eq("write_to: file content", file_read("strbuf_test.tmp"), "alpha\nbeta\n");
    file_delete("strbuf_test.tmp");

    delete f;
    delete sb;
}

define main() -> int
{
    writeln "strbuf tests";

    test_basic();
    test_addend_numbers();
    test_repeat_join();
    test_edit();
    test_read();
    test_create_copy();
    test_null_safety();
    test_output();

    writeln;
    writeln $"passed: {g_pass}, failed: {g_fail}";
    if (g_fail == 0) { writeln "ALL PASSED"; }
    else { writeln "SOME TESTS FAILED"; }

    return g_fail;
}